# Supabase Database Configuration
# Copy this file to .env and fill in your actual values

# Database connection URL (optional - defaults to Supabase project URL)
# JDBC_URL=jdbc:postgresql://db.elapmouaiondwnzmtlhj.supabase.co:5432/postgres

# Database username (defaults to 'postgres')
# DB_USER=postgres

# Database password (REQUIRED - get this from your Supabase project settings)
# This is different from the API key - it's the database password
# You can find it in: Supabase Dashboard > Project Settings > Database
DB_PASSWORD=your_database_password_here
